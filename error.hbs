{{!< default}}

{{!-- Every error except 404 (see error-404.hbs). Kept free of {{#get}}:
     a 500 usually means the server is struggling, so no extra API calls. --}}
{{#contentFor "html_class"}}is-error-page{{/contentFor}}

<div class="error-page">
	<div class="inner">
		<div class="error-content">
			<div class="error-card">
				<h1 class="error-title">{{statusCode}}</h1>
				<p class="error-description">{{t "Something went wrong. Please try again."}}</p>
				<a href="{{@site.url}}" class="error-button">
					<i class="icon icon-arrow-left" aria-hidden="true">{{> "icons/icon-arrow-left"}}</i>
					<span>{{t "Return Home"}}</span>
				</a>
			</div>
		</div>
	</div>
</div>
