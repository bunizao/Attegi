{
  "name": "attegi",
  "description": "Attegi is an elegant and dynamic Ghost theme, with a modern design, deep support for Ghost, and specially optimized for mobile devices.",
  "demo": "https://attegi.tuuhub.com",
  "version": "6.11.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "packageManager": "bun@1.3.13",
  "license": "AGPL-3.0-only",
  "screenshots": {
    "desktop": "screenshots/homepage-dark.png",
    "mobile": "screenshots/iphone.png"
  },
  "author": {
    "name": "bunizao",
    "email": "me@tutuis.me",
    "url": "https://tutuis.me"
  },
  "gpm": {
    "type": "theme",
    "categories": [
      "Minimal",
      "Personal Blogs"
    ]
  },
  "keywords": [
    "ghost-theme",
    "ghost",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bunizao/Attegi.git"
  },
  "scripts": {
    "css:sass:dev": "sass src/sass/style.scss assets/css/style.css --source-map --style=expanded",
    "css:sass:build": "sass src/sass/style.scss assets/css/style.css --no-source-map --style=compressed && postcss assets/css/style.css -o assets/css/style.css --env production",
    "css:sass:watch": "sass src/sass/style.scss assets/css/style.css --source-map --style=expanded --watch",
    "css:utilities:dev": "postcss src/sass/utilities.css -o assets/css/utilities.css -u @tailwindcss/postcss --no-map",
    "css:utilities:build": "postcss src/sass/utilities.css -o assets/css/utilities.css -u @tailwindcss/postcss -u cssnano --no-map",
    "css:utilities:watch": "postcss src/sass/utilities.css -o assets/css/utilities.css -u @tailwindcss/postcss --no-map --watch",
    "css:dev": "bun run css:sass:dev && bun run css:utilities:dev",
    "css:build": "bun run css:sass:build && bun run css:utilities:build",
    "css:watch": "bun scripts/dev.js css",
    "js:dev": "bun scripts/build.js --dev",
    "js:build": "bun scripts/build.js --prod",
    "js:watch": "bun scripts/build.js --watch",
    "serve:hot": "bun scripts/dev-hot.js",
    "serve:preview": "bun scripts/dev-preview.js",
    "dev": "bun scripts/dev.js",
    "dev:hot": "bun scripts/dev.js hot",
    "dev:preview": "bun scripts/dev.js preview",
    "build": "bun run css:build && bun run js:build",
    "compress": "bun run build && bun scripts/compress.js",
    "clean": "rm -rf assets/js/*.js assets/css/style.css assets/css/style.css.map assets/css/utilities.css dist/",
    "validate": "bun run compress && bunx gscan -z dist/attegi.zip"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "archiver": "^7.0.0",
    "autoprefixer": "^10.5.0",
    "browser-sync": "^3.0.4",
    "cssnano": "^8.0.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.13",
    "postcss-cli": "^11.0.0",
    "sass": "^1.99.0",
    "tailwindcss": "^4.2.4",
    "tocbot": "^4.36.4"
  },
  "config": {
    "posts_per_page": 8,
    "image_sizes": {
      "s": {
        "width": 320
      },
      "m": {
        "width": 640
      },
      "l": {
        "width": 960
      },
      "xl": {
        "width": 1920
      }
    },
    "card_assets": true,
    "custom": {
      "color_scheme": {
        "type": "select",
        "options": [
          "Light",
          "Dark",
          "System"
        ],
        "default": "System"
      },
      "darkmode_accent_color": {
        "type": "color",
        "default": "#82C0CC"
      },
      "instagram_url": {
        "type": "text",
        "description": "Social media links displayed in the page footer."
      },
      "github_url": {
        "type": "text"
      },
      "telegram_url": {
        "type": "text"
      },
      "discord_url": {
        "type": "text"
      },
      "bluesky_url": {
        "type": "text"
      },
      "email_address": {
        "type": "text"
      },
      "footer_text": {
        "type": "text",
        "description": "Custom text displayed in footer center. HTML snippets can be inserted."
      },
      "og_service_url": {
        "type": "text",
        "description": "Optional OG image service base URL. Leave empty to use Ghost defaults."
      },
      "og_service_theme": {
        "type": "text",
        "description": "Optional theme name for the OG image service."
      },
      "email_signup_text": {
        "type": "text",
        "default": "Sign up for more like this.",
        "group": "post"
      },
      "show_recent_posts_footer": {
        "type": "boolean",
        "default": true,
        "group": "post"
      },
      "post_share": {
        "type": "select",
        "options": [
          "Default",
          "Native",
          "Disabled"
        ],
        "default": "Default",
        "group": "post"
      },
      "disqus_shortname": {
        "type": "text",
        "default": "",
        "group": "post"
      }
    }
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "handlebars": "^4.7.9"
  }
}
