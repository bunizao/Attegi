{{!--
    social-links.hbs
    ----------------
    Native social accounts from Ghost Admin (Ghost 5.118+). Pass the owner as
    `source`: `@site` in the footer, the author on author.hbs. Each link is
    guarded on `source` itself because `social_url` falls back to the site's
    accounts, which would leak onto an author without their own.
    Params: source, link_class
--}}
{{#if source.twitter}}<a class="{{link_class}}" href="{{social_url type="twitter"}}" aria-label="X" title="X" target="_blank" rel="noopener">
	<i class="icon icon-x" aria-hidden="true">{{> "icons/icon-x"}}</i>
</a>{{/if}}
