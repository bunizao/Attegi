<!DOCTYPE html>
{{!-- `html_class` is set per-template via {{#contentFor "html_class"}} (index/post/page
add "cover-active" when a cover image is present; error adds "is-error-page"). Home's
own cover-active case is already covered there, so this attribute only needs the block. --}}
<html lang="{{@site.locale}}" class="{{{block "html_class"}}}">
<head>

	{{!-- Document Settings --}}
	<meta charset="utf-8" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />

	{{!-- Base Meta --}}
	<title>{{meta_title}}</title>
	<meta name="HandheldFriendly" content="True" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	{{!-- Mobile browser chrome color. Both default to the matching theme's
	--color-background-main; the bootstrap script below keeps them correct
	when the visitor or @custom.color_scheme forces a theme against the OS
	preference. --}}
	<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
	<meta name="theme-color" content="#1D1F21" media="(prefers-color-scheme: dark)" />
	{{{block "head"}}}

	{{!-- Resource Hints --}}
	{{!-- Preload critical CSS to reduce render-blocking --}}
	<link rel="preload" href="{{asset "css/style.css"}}" as="style" />
	{{!-- Note: GLightbox and JetBrains Mono are NOT loaded here; both are
	injected only when the rendered body actually needs them (see the
	conditional-load scripts near the closing </body>). --}}

		<script>
			// Theme bootstrap - runs once, before first paint.
			// - Resolves the theme from localStorage / @custom.color_scheme / OS
			//   preference and applies .theme-dark or .theme-light immediately
			//   (no flash of the wrong theme).
			// - Computes --color-on-accent for both the light and dark accent
			//   colors from their luminance, since a Ghost admin can pick any
			//   accent; the CSS fallbacks in _colors.scss only cover the
			//   shipped defaults.
			// - Also derives --color-accent-text: if the picked accent has
			//   under 3:1 contrast against the page background, this is a
			//   darkened/lightened variant readable as text (links etc.);
			//   otherwise it's just the accent itself. Accent-colored fills
			//   keep using --ghost-accent-color directly.
			// - Keeps <meta name="theme-color"> in sync with the resolved theme.
			// src/js/features/theme-switcher.js repeats the same theme-color
			// and localStorage update when the visitor uses the toggle.
			(function () {
				var docEl = document.documentElement;
				var customScheme = ('{{@custom.color_scheme}}' || 'System').toLowerCase();
				var lightAccent = '{{@site.accent_color}}' || '#3A6B7E';
				var darkAccent = '{{@custom.darkmode_accent_color}}' || '#82C0CC';
				var mql = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;

				function isDark(choice) {
					if (choice === 'dark') return true;
					if (choice === 'light') return false;
					return !!(mql && mql.matches);
				}

				function updateThemeColor(dark) {
					var color = dark ? '#1D1F21' : '#FFFFFF';
					var metas = document.querySelectorAll('meta[name="theme-color"]');
					for (var i = 0; i < metas.length; i++) {
						metas[i].setAttribute('content', color);
					}
				}

				function applyTheme(choice) {
					var dark = isDark(choice);
					docEl.classList.remove('theme-dark', 'theme-light', 'theme-system');
					docEl.classList.add(dark ? 'theme-dark' : 'theme-light');
					if (choice !== 'dark' && choice !== 'light') {
						docEl.classList.add('theme-system');
					}
					updateThemeColor(dark);
				}

				function lin(c) {
					c = c / 255;
					return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
				}

				function luminanceOf(hex) {
					var m = /^#?([0-9a-f]{6})$/i.exec(hex || '');
					if (!m) return null;
					var n = parseInt(m[1], 16);
					return 0.2126 * lin((n >> 16) & 255) + 0.7152 * lin((n >> 8) & 255) + 0.0722 * lin(n & 255);
				}

				// Relative luminance -> pick whichever of near-black/white has
				// more contrast against the given accent color.
				function onAccentFor(hex) {
					var luminance = luminanceOf(hex);
					if (luminance === null) return '#fff';
					// Luminance where contrast(white, L) === contrast(black, L).
					return luminance > 0.1791 ? '#1D1F21' : '#fff';
				}

				function contrastOf(l1, l2) {
					var lighter = Math.max(l1, l2), darker = Math.min(l1, l2);
					return (lighter + 0.05) / (darker + 0.05);
				}

				// Nudge an accent toward black/white, in steps, until it clears a
				// 3:1 contrast against the page background - only for TEXT use
				// (links etc.); accent-colored fills keep the raw admin color.
				function readableAccentFor(hex, bgHex) {
					var bgLum = luminanceOf(bgHex);
					var lum = luminanceOf(hex);
					if (lum === null || bgLum === null || contrastOf(lum, bgLum) >= 3) return hex;
					var m = /^#?([0-9a-f]{6})$/i.exec(hex);
					var n = parseInt(m[1], 16);
					var r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
					var target = bgLum > 0.5 ? 0 : 255;
					for (var i = 1; i <= 10; i++) {
						var amount = i / 10;
						var cr = Math.round(r + (target - r) * amount);
						var cg = Math.round(g + (target - g) * amount);
						var cb = Math.round(b + (target - b) * amount);
						var candidate = '#' + ((1 << 24) + (cr << 16) + (cg << 8) + cb).toString(16).slice(1);
						if (contrastOf(luminanceOf(candidate), bgLum) >= 3) return candidate;
					}
					return target === 0 ? '#000' : '#fff';
				}

				var lightAccentText = readableAccentFor(lightAccent, '#ffffff');
				var darkAccentText = readableAccentFor(darkAccent, '#1D1F21');

				var accentStyle = document.createElement('style');
				accentStyle.textContent =
					':root { --color-on-accent: ' + onAccentFor(lightAccent) + '; --color-accent-text: ' + lightAccentText + '; }' +
					'.theme-dark:root { --color-on-accent: ' + onAccentFor(darkAccent) + '; --ghost-accent-color: ' + darkAccent + '; --color-accent-text: ' + darkAccentText + '; }' +
					'@media (prefers-color-scheme: dark) { html:not(.theme-light):root { --color-on-accent: ' + onAccentFor(darkAccent) + '; --ghost-accent-color: ' + darkAccent + '; --color-accent-text: ' + darkAccentText + '; } }';
				document.head.appendChild(accentStyle);

				// Hide the toggle when @custom.color_scheme forces a theme.
				if (customScheme === 'dark' || customScheme === 'light') {
					var hideThemeStyle = document.createElement('style');
					hideThemeStyle.textContent = '.js-theme {display:none!important;}';
					document.head.appendChild(hideThemeStyle);
				}

				var hasStored = !!localStorage.getItem('attegi_theme');
				var stored = localStorage.getItem('attegi_theme') || customScheme;
				applyTheme(stored);
				if (!hasStored) {
					localStorage.setItem('attegi_theme', stored);
				}

				// Track the OS preference while "system" is active.
				function onSystemChange() {
					if ((localStorage.getItem('attegi_theme') || 'system') === 'system') {
						applyTheme('system');
					}
				}
				if (mql && mql.addEventListener) {
					mql.addEventListener('change', onSystemChange);
				} else if (mql && mql.addListener) {
					mql.addListener(onSystemChange);
				}
			})();
		</script>

	{{!-- Critical CSS - Inlined for faster FCP and reduced CLS.
	This is a hand-maintained subset of src/sass/style.scss (the "CLS
	prevention rules" section and .nav-header) that has to paint before the
	real stylesheet loads; keep the two in sync by hand when either changes. --}}
	<style>
		/* Critical layout styles to prevent CLS */
		html{font-size:62.5%}
		body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;margin:0;background:var(--color-background-main,#fff)}
		img{max-width:100%;height:auto}
		.nav-header{position:fixed;top:0;left:0;width:100%;z-index:var(--z-nav,400)}
		.nav-header .logo img{width:auto;height:4rem}
		.skip-link{position:absolute;top:-100%;left:0;z-index:9999}
		.skip-link:focus{top:0}
		.post-meta-avatar{width:3.6rem;height:3.6rem;flex-shrink:0}
		.blog-cover,.post-cover{contain:layout style paint;contain-intrinsic-size:100vw 50vh}
		.kg-bookmark-thumbnail{aspect-ratio:1.2/1;min-height:160px}
		.kg-embed-card iframe[src*="youtube"],.kg-embed-card iframe[src*="vimeo"]{aspect-ratio:16/9;width:100%;height:auto}
		/* Link styles */
		a.nav-search,
		.post-meta-author a,
		.post-meta-avatars a {
			color: inherit;
			text-decoration: none;
			-webkit-tap-highlight-color: transparent;
		}
		a.nav-search:link,
		a.nav-search:visited,
		.post-meta-author a:link,
		.post-meta-author a:visited,
		.post-meta-avatars a:link,
		.post-meta-avatars a:visited {
			color: inherit;
			text-decoration: none;
		}
		/* Skeleton loading animation - kept in sync by hand with the real
		   rule in src/sass/style.scss (.skeleton / @keyframes skeleton-loading);
		   this copy has to paint before style.css loads. */
		.skeleton{background:linear-gradient(90deg,#f0f0f0 25%,#e0e0e0 50%,#f0f0f0 75%);background-size:200% 100%;animation:skeleton-loading 1.5s ease-in-out infinite;border-radius:4px}
		@keyframes skeleton-loading{0%{background-position:200% 0}100%{background-position:-200% 0}}
	</style>
	<link rel="stylesheet" href="{{asset "css/style.css"}}" />
	<script>
		/* Avoid noisy analytics calls in local/dev */
		(function () {
			var isLocal = /localhost|127\.0\.0\.1/.test(location.hostname);
			if (!isLocal) return;

			function isAnalyticsHost(url) {
				try {
					var host = new URL(url, location.href).hostname;
					return host === 'google-analytics.com' || host.endsWith('.google-analytics.com');
				} catch (e) {
					return false;
				}
			}

			var nativeSendBeacon = navigator.sendBeacon ? navigator.sendBeacon.bind(navigator) : null;
			navigator.sendBeacon = function (url, data) {
				if (typeof url === 'string' && isAnalyticsHost(url)) return true;
				return nativeSendBeacon ? nativeSendBeacon(url, data) : false;
			};
			if (window.fetch) {
				var origFetch = window.fetch.bind(window);
				window.fetch = function (input, init) {
					var url = (typeof input === 'string') ? input : (input && input.url);
					if (url && isAnalyticsHost(url)) {
						return Promise.resolve(new Response('', { status: 204, statusText: 'blocked' }));
					}
					return origFetch(input, init);
				};
			}
		})();
	</script>

	<script>
			var siteUrl = '{{@site.url}}';
	</script>

	{{#if @custom.og_service_url}}
		{{ghost_head exclude="social_data"}}
	{{else}}
		{{ghost_head}}
	{{/if}}

	{{!-- Optional social metadata override (home/post/page/tag/author) --}}
	{{!-- Keep Ghost runtime assets while replacing its default OG/Twitter tags. --}}
	{{!-- Using format="jpeg" to ensure compatibility with @vercel/og (WebP not supported) --}}
