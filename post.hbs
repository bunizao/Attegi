{{!< default}}

{{!-- Reading progress bar, filled by src/js/features/progress-bar.js --}}
<div class="progress-container">
	<div class="progress-bar"></div>
</div>

{{!-- Back to top button with progress ring (shown when no TOC) --}}
<button class="back-to-top" aria-label="{{t "Back to top"}}">
	<svg class="progress-ring" viewBox="0 0 44 44">
		<circle class="progress-ring__bg" cx="22" cy="22" r="20"></circle>
		<circle class="progress-ring__progress" cx="22" cy="22" r="20"></circle>
	</svg>
	<svg class="back-to-top__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<polyline points="18 15 12 9 6 15"></polyline>
	</svg>
</button>

{{!-- Everything inside the #post tags pulls data from the post --}}
{{#post}}

{{#if feature_image}}
{{#contentFor "html_class"}}cover-active{{/contentFor}}
{{/if}}

<header class="post-header {{#if feature_image}} has-cover {{/if}}">
	<div class="inner">
		<h1 class="post-title">{{{title}}}</h1>
		<div class="post-meta">
			<div class="post-meta-avatars">
				{{#foreach authors}}
					{{!-- Author avatar with SVG fallback --}}
					{{#if profile_image}}
						<figure class="post-meta-avatar">
							<a href="{{url}}" class="author-avatar" aria-label="{{name}}">
								<picture>
									<img class="author-profile-image" src="{{img_url profile_image size="xs" quality="80"}}" alt="" loading="lazy" decoding="async" />
								</picture>
							</a>
						</figure>
					{{else}}
						<figure class="post-meta-avatar avatar" aria-label="{{name}}">
							<a href="{{url}}" class="author-avatar" aria-label="{{name}}">
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
								</svg>
							</a>
						</figure>
					{{/if}}
				{{/foreach}}
			</div>
			<p class="post-meta-author">
				{{#foreach authors}}
					{{#unless @first}}{{#if @last}}{{t " & "}}{{else}}{{t ", "}}{{/if}}{{/unless}}<a href="{{url}}">{{name}}</a>
				{{/foreach}}
			</p>
			<span class="post-meta-details"><time datetime="{{date format='YYYY-MM-DD'}}">{{date format="MMM DD, YYYY"}}</time><span class="post-meta-sep" aria-hidden="true">•</span><span class="post-meta-reading">{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span></span>
		</div>
		{{#if feature_image}}
		{{!-- No crossorigin on the cover <img>: it would let cover-detect.js read
		     pixels on CORS-enabled hosts, but blanks the cover on storage adapters
		     that don't send CORS headers. Brightness detection stays best-effort. --}}
		<div class="post-cover cover">
			<picture>
				<source
					srcset="{{> "srcset" image=feature_image quality="50" include_xl=true}}"
					sizes="100vw" />
				<img
					srcset="{{> "srcset" image=feature_image quality="50" include_xl=true}}"
					sizes="100vw"
					src="{{img_url feature_image size="xl" quality="50"}}"
					alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
					loading="eager"
					decoding="async"
					fetchpriority="high" />
			</picture>
		</div>
		{{/if}}
	</div>
</header>

<div class="content">
	<article class="{{post_class}}">
		<div class="inner">

			{{!-- Feature image caption/credit --}}
			{{#if feature_image_caption}}
			<figcaption class="post-cover-credit">{{{feature_image_caption}}}</figcaption>
			{{/if}}

			{{!-- Add no-toc class if #no-toc tag is present --}}
			<section class="post-content{{#has tag="#no-toc"}} no-toc{{/has}}">
				{{content}}
			</section>
			{{!-- Hide `[!poem]` blockquotes until post.js (deferred) turns them
			     into cards, so the raw syntax never paints. Inline and right
			     after the content so it runs before the parser yields a frame. --}}
			<script>
				document.querySelectorAll('.post-content blockquote').forEach(function (q) {
					if (q.textContent.indexOf('[!poem]') !== -1) q.classList.add('kg-poem-pending');
				});
			</script>

		<section class="post-footer">

			{{!-- Not By AI Badge - Above all footer content --}}
			{{> "notbyai-badge"}}

			{{!-- Flexbox container for Share + Tags --}}
			<div class="post-footer-meta">
				{{#if tags}}
				<aside class="post-tags">
					<span class="post-info-label">{{t "Topic"}}</span>
					{{tags separator=" " visibility="public"}}
				</aside>
				{{/if}}

					<div class="post-share js-share-native" hidden>
						<span class="post-info-label">{{t "Share"}}</span>
						<button aria-label="{{t "Share"}} {{t "Article"}}" class="post-share-button" id="share-button"><span class="icon icon-share" aria-hidden="true">{{> "icons/icon-share"}}</span></button>
					</div>

					<div class="post-share js-share-default" hidden>
						<span class="post-info-label">{{t "Share"}}</span>
						<a title="{{t "Twitter"}}" aria-label="{{t "Twitter"}}" class="twitter js-share-popup" data-popup-size="550,235" href="https://twitter.com/share?text={{encode title}}&url={{url absolute="true"}}">
							<span class="icon icon-twitter" aria-hidden="true">{{> "icons/icon-twitter"}}</span>
						</a>
						<a title="{{t "Facebook"}}" aria-label="{{t "Facebook"}}" class="facebook js-share-popup" data-popup-size="580,296" href="https://www.facebook.com/sharer/sharer.php?u={{url absolute="true"}}">
							<span class="icon icon-facebook" aria-hidden="true">{{> "icons/icon-facebook"}}</span>
						</a>
						<a title="{{t "LinkedIn"}}" aria-label="{{t "LinkedIn"}}" class="linkedin js-share-popup" data-popup-size="930,720" href="https://www.linkedin.com/shareArticle?mini=true&amp;url={{url absolute="true"}}&amp;title={{encode title}}">
							<span class="icon icon-linkedin" aria-hidden="true">{{> "icons/icon-linkedin"}}</span>
						</a>
						<a title="{{t "Email"}}" aria-label="{{t "Email"}}" class="email" href="mailto:?subject={{encode title}}&amp;body={{url absolute="true"}}">
							<span class="icon icon-mail" aria-hidden="true">{{> "icons/icon-mail"}}</span>
						</a>
					</div>
				</div>

				<script>
				(function() {
					var sharePref = '{{@custom.post_share}}';
					var nativeShare = document.querySelector('.js-share-native');
					var defaultShare = document.querySelector('.js-share-default');

					// Hide both by default
					if (nativeShare) nativeShare.hidden = true;
					if (defaultShare) defaultShare.hidden = true;

					// Show only the selected share type
					if (sharePref === 'Native' && nativeShare) {
						nativeShare.hidden = false;
					} else if (sharePref === 'Default' && defaultShare) {
						defaultShare.hidden = false;
					}
					// If sharePref === 'Disabled', both remain hidden
				})();
				</script>

			</section>

			{{#if comments}}
			<section class="post-comments" data-comments-section>
				<header class="post-comments-header">
					<h3 class="post-comments-title">{{t "Comments"}}</h3>
					<span class="post-comments-count">{{comment_count autowrap="false" empty=(t "0 comments")}}</span>
				</header>
				<button class="post-comments-load js-load-comments" type="button" aria-controls="comments-container" aria-expanded="false">
					<span class="post-comments-load-label">{{t "Show Comments"}}</span>
				</button>
				<div id="comments-container" class="post-comments-container" data-comments-placeholder></div>
				<template id="ghost-comments-template">
					{{comments title="" count=false}}
				</template>
			</section>
			{{else if @custom.disqus_shortname}}
			<section class="post-comments">
				<div id="disqus_thread" data-disqus-shortname="{{@custom.disqus_shortname}}"></div>
			</section>
			{{/if}}

      {{!-- Free email signup only works when anyone can join; invite-only
           and paid-only sites go through Portal from the header instead. --}}
      {{#match @site.members_signup_access "=" "all"}}
      <section class="post-subscribe">
        {{#unless @member}}
        	<p class="post-subscribe-text">{{#if @custom.email_signup_text}}{{@custom.email_signup_text}}{{else}}{{t "Sign up for more like this."}}{{/if}}</p>
        	<form class="post-subscribe-form" data-members-form="subscribe">
        		<input class="post-subscribe-input" data-members-email type="email" name="email" autocomplete="email" required placeholder="{{t "Your email address"}}" aria-label="{{t "Your email address"}}">
        		<button class="post-subscribe-button" type="submit">{{t "Subscribe"}}</button>
        	</form>
        	<p class="post-subscribe-message post-subscribe-success" role="status">{{t "Check your inbox to confirm your subscription."}}</p>
        	<p class="post-subscribe-message post-subscribe-error" role="alert">{{t "Something went wrong. Please try again."}}</p>
        {{/unless}}
      </section>
      {{/match}}

			{{> "recent-posts"}}

		</div>
	</article>
</div>

{{/post}}

{{!-- The #contentFor helper here will send everything inside it up to the matching #block helper found in default.hbs --}}
{{#if feature_image}}
{{#contentFor "head"}}
<link rel="preload"
	as="image"
	href="{{img_url feature_image size="xl" quality="50"}}"
	imagesrcset="{{> "srcset" image=feature_image quality="50" include_xl=true}}"
	imagesizes="100vw">
{{/contentFor}}
{{/if}}
{{#contentFor "scripts"}}
<script defer src="{{asset "js/tocbot.min.js"}}"></script>
<script defer src="{{asset "js/post.js"}}" data-highlight="{{asset "js/highlight.pack.js"}}"></script>
{{/contentFor}}
